# Copy this file to .env and fill in real values. Never commit .env.

SHINZO_ENV=development

# --- Database ---
DATABASE_URL=sqlite:///./shinzo.db

# --- LLM provider ---
# LLM_PROVIDER selects which class in app/model/provider_base.py is used.
#   mock     -> deterministic echo provider, no downloads, used for local dev/tests
#   local_hf -> loads a real Hugging Face model via transformers
LLM_PROVIDER=mock
LLM_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
LLM_ADAPTER_PATH=
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.8

# --- Emotion classifier ---
EMOTION_MODEL_NAME=j-hartmann/emotion-english-distilroberta-base

# --- API security ---
API_KEY_HASH_ALGO=argon2
RATE_LIMIT_PER_MINUTE=60

# --- Proactive engine ---
PROACTIVE_ENABLED=true
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00

# --- Logging ---
LOG_LEVEL=INFO
